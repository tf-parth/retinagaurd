# ==========================================
# RetinaGuard AI - Environment Configuration
# SIH 2026 Problem Statement 26038
# ==========================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Uses SQLite locally by default for instant zero-dependency execution.
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/retinaguard
DATABASE_URL=sqlite:///./retinaguard.db

# Storage Configuration
# Local storage directory or S3 compatible bucket
STORAGE_TYPE=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,tif,tiff

# Machine Learning & Inference
MODEL_ARCHITECTURE=efficientnet_b0
MODEL_WEIGHTS_PATH=./ml/weights/retinaguard_efficientnet_b0.pth
MODEL_DEVICE=cpu
ENABLE_GRADCAM=True
CONFIDENCE_THRESHOLD_REFERABLE=0.50

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
